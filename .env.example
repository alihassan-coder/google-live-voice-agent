# ── Required ──────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
# Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# ── Optional ──────────────────────────────────────────────
# Live model (default: gemini-3.8-live)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Extra origins allowed to request call tokens, comma-separated.
# The site's own domain is always allowed.
ALLOWED_ORIGINS=

# Shown in the page CTAs
NEXT_PUBLIC_CONTACT_EMAIL=alihassan.coder@gmail.com
NEXT_PUBLIC_BOOKING_URL=
# Optional: shown as "Call or text" on the contact page
NEXT_PUBLIC_CONTACT_PHONE=

# ── Contact form (optional) ───────────────────────────────
# With a free Resend key (https://resend.com/api-keys) the /contact form emails
# you directly. Without it, visitors get a pre-filled Gmail / email / copy fallback.
RESEND_API_KEY=
# Where form submissions go (default: NEXT_PUBLIC_CONTACT_EMAIL)
CONTACT_TO_EMAIL=
# Sender. Keep the default until you verify your own domain in Resend.
CONTACT_FROM_EMAIL=

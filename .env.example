# ── Required ──────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
# Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# ── Optional ──────────────────────────────────────────────
# Live model (default: gemini-3.8-live)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Extra origins allowed to request call tokens, comma-separated.
# The site's own domain is always allowed.
ALLOWED_ORIGINS=

# Shown in the page CTAs
NEXT_PUBLIC_CONTACT_EMAIL=alihassan.coder@gmail.com
NEXT_PUBLIC_BOOKING_URL=
